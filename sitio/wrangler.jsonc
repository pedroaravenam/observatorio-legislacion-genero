{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "observatorio-legislacion-genero",
	"compatibility_date": "2026-11-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "observatorio-legislacion-genero",
			"database_id": "95e618c7-9f82-4df1-a0e7-6eece16b80b3"
		}
	],
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": false
}
