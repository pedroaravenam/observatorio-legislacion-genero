{
	"name": "observatorio-sitio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node --disable-warning=ExperimentalWarning build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"pruebas:navegadores": "node pruebas/navegadores.mjs",
		"pruebas:accesibilidad": "node pruebas/accesibilidad.mjs",
		"pruebas:consistencia": "node --disable-warning=ExperimentalWarning pruebas/consistencia.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/assets/*": "./src/lib/assets/*",
		"#lib/*": "./src/lib/*.ts"
	},
	"packageManager": "npm@11.19.0",
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0"
	}
}
